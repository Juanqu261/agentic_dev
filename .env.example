# ── pod-brain (LangGraph orchestrator) ───────────────────────────────────────
# All variables are prefixed with POD_BRAIN_ and read by packages/pod-brain/pod_brain/config.py

# Required: Anthropic API key for LLM calls (Architect, Builder, QA agents)
POD_BRAIN_ANTHROPIC_API_KEY=sk-ant-...

# Claude model to use for all agents
POD_BRAIN_ANTHROPIC_MODEL=claude-sonnet-4-5

# URL of the running pod-mcp server (default: http://localhost:8001)
POD_BRAIN_POD_MCP_URL=http://localhost:8001

# URL of the running ChromaDB instance used by the Architect for semantic context
# ChromaDB default port is 8000. studio-api runs on 8080 to avoid collision.
POD_BRAIN_CHROMA_URL=http://localhost:8000

# Checkpointer storage for LangGraph thread state.
# Options:
#   :memory:           — in-process only, lost on restart (default, good for dev)
#   ./checkpoints.db   — SQLite file, persistent across restarts (single-process)
#   postgres://user:pass@host:5432/dbname  — Postgres (multi-process / production)
POD_BRAIN_CHECKPOINTER_DB=:memory:

# Maximum times the Builder agent retries before escalating to human review
POD_BRAIN_MAX_BUILDER_LOOPS=3

# Maximum times the Architect agent re-designs before escalating to human review
POD_BRAIN_MAX_ARCHITECT_LOOPS=2

# Log level for the pod-brain package (DEBUG | INFO | WARNING | ERROR)
POD_BRAIN_LOG_LEVEL=INFO


# ── pod-mcp (MCP tool server) ─────────────────────────────────────────────────
# Read directly from the environment by packages/pod-mcp/pod_mcp/tools/_security.py
# and packages/pod-mcp/pod_mcp/server.py — no prefix.

# Required: absolute path to the target repository that the agents will read/write.
# This is the external project being built, NOT the agentic-devstudio repo itself.
TARGET_REPO_PATH=/absolute/path/to/your/target/repo

# Port the pod-mcp FastAPI server listens on (default: 8001, must match POD_BRAIN_POD_MCP_URL)
POD_MCP_PORT=8001
